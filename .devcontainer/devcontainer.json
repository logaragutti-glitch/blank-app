{
  "name": "EVE OS (Node 20)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "updateContentCommand": "corepack enable && pnpm install",
  "portsAttributes": {
    "3000": { "label": "Web", "onAutoForward": "openPreview" },
    "3001": { "label": "Admin", "onAutoForward": "notify" },
    "4000": { "label": "API", "onAutoForward": "notify" }
  },
  "forwardPorts": [3000, 3001, 4000, 5432, 6379, 5672, 15672, 9200]
}
