NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://eve:eve@localhost:5432/eve_os
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://eve:eve@localhost:5672
OPENSEARCH_URL=http://localhost:9200

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=eve
S3_SECRET_KEY=eve12345
S3_BUCKET=eve-os-inspiration

# Required for the Briefing Engine's Vision AI / embedding pipeline.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google AI Studio — powers the conceptual render feature (Capa + 10
# ambientes narrativos), GeminiConceptualRenderProvider. Get a free key at
# https://aistudio.google.com/apikey. Leave empty and that one endpoint
# fails with a clear error; nothing else in the system depends on it.
GOOGLE_AI_API_KEY=
# Optional — both already default sensibly (gemini-3-pro-image / 2K).
GOOGLE_AI_IMAGE_MODEL=
GOOGLE_AI_IMAGE_SIZE=

JWT_SECRET=change-me-in-production

# Used to build the password reset / invite links (point at apps/web).
WEB_APP_URL=http://localhost:3000

# Optional: sends real email (password reset, team invites) via Gmail or
# Google Workspace SMTP. Leave both empty to fall back to logging the link
# instead — see docs/11-deployment-guide.md for how to generate an App
# Password (requires 2-Step Verification on the Google account).
GMAIL_USER=
GMAIL_APP_PASSWORD=
