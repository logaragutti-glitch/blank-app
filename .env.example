# Copy to .env and adjust as needed. Loaded by docker-compose and local dev scripts.

NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve
POSTGRES_DB=eve_os
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eve:eve@localhost:5432/eve_os

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_USER=eve
RABBITMQ_PASSWORD=eve
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://eve:eve@localhost:5672

# --- OpenSearch ---
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200

# --- S3-compatible storage (MinIO locally) ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=eve
S3_SECRET_KEY=eve12345
S3_BUCKET=eve-os-inspiration

# --- AI providers (Briefing Engine: Agente 2 Vision AI + embeddings) ---
# Required for real image analysis/embeddings; leave empty to run with the
# Knowledge Graph / storage plumbing only (AI calls will fail with a clear
# error instead of silently no-op'ing).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Apps ---
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

JWT_SECRET=change-me-in-production

# Used to build the password reset link sent by "forgot password". No real
# email provider is configured — see docs/11-deployment-guide.md.
WEB_APP_URL=http://localhost:3000
