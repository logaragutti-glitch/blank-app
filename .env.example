# Copy to .env and adjust as needed. Loaded by docker-compose and local dev scripts.

NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve
POSTGRES_DB=eve_os
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eve:eve@localhost:5432/eve_os

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_USER=eve
RABBITMQ_PASSWORD=eve
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://eve:eve@localhost:5672

# --- OpenSearch ---
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200

# --- Apps ---
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

JWT_SECRET=change-me-in-production
